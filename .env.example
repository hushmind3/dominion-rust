# Main OpenAI-compatible provider
DOMINION_BIND=127.0.0.1:4317
DOMINION_BASE_URL=https://api.openai.com/v1
DOMINION_MODEL=your-available-model
DOMINION_API_KEY=
# Economy provider (defaults to main if omitted)
DOMINION_ECONOMY_BASE_URL=
DOMINION_ECONOMY_MODEL=
DOMINION_ECONOMY_API_KEY=
# Set actual rates in KRW per 1,000,000 input / output tokens.
DOMINION_INPUT_KRW_PER_MTOK=0
DOMINION_CACHED_INPUT_KRW_PER_MTOK=0
DOMINION_OUTPUT_KRW_PER_MTOK=0
DOMINION_ECONOMY_INPUT_KRW_PER_MTOK=0
DOMINION_ECONOMY_CACHED_INPUT_KRW_PER_MTOK=0
DOMINION_ECONOMY_OUTPUT_KRW_PER_MTOK=0
# Runtime data and scoped file artifacts
DOMINION_DATA_DIR=./runtime
DOMINION_WORKSPACE_DIR=./workspace
DOMINION_MAX_STEPS=30
# Serialized model-input characters; not a token count
DOMINION_CONTEXT_MAX_CHARS=80000
# Off by default. On allows explicitly approved subprocesses.
DOMINION_ENABLE_SHELL=false
# Mandatory when exposing a non-loopback listen address
DOMINION_ACCESS_TOKEN=
# Optional: suppress primitive local espeak narration
DOMINION_DISABLE_TTS=false

# Optional 2026-07-28 stateless MCP Streamable HTTP endpoints.
# Use external secret injection for bearer_token in production.
# DOMINION_MCP_SERVERS='[{"name":"filesystem","url":"http://127.0.0.1:3400/mcp","bearer_token":""}]'

# Optional real-motion Veo 3.1 video generation
DOMINION_VEO_API_KEY=
DOMINION_VEO_MODEL=veo-3.1-generate-preview
# Actual video provider rate, in Korean won per generated second. Set before billing.
DOMINION_VEO_KRW_PER_SECOND=0

# Optional override for the pre-built main React frontend (default: <repo>/web/dist)
# DOMINION_WEB_DIR=/path/to/web/dist

# Approved shell and RSI test/score isolation: required (default) or explicit off.
# Linux requires bubblewrap; macOS requires sandbox-exec. Unavailable backends fail closed.
DOMINION_SHELL_SANDBOX=required

# OpenAI-specific optional prompt cache routing and minimum TTL.
# Other OpenAI-compatible providers do not receive these proprietary fields.
# DOMINION_PROMPT_CACHE_KEY=dominion-workspace
# DOMINION_PROMPT_CACHE_TTL=30m
# Cache write rates vary by model and TTL (e.g. 12h writes may cost 2.5x input).
# DOMINION_CACHE_WRITE_KRW_PER_MTOK=...
# DOMINION_ECONOMY_CACHE_WRITE_KRW_PER_MTOK=...

# True allows a model to submit multiple tool calls per turn. Compatible providers
# can opt out; the Rust engine still enforces admission, ordering and permissions.
DOMINION_PARALLEL_TOOL_CALLS=true
# Bound how many pure workspace inspection tools execute at once (1..8).
# Mutating tools, shell, MCP and subagent spawning always remain exclusive.
DOMINION_MAX_PARALLEL_READS=4

# Deterministic native tool hooks, applied before dispatch and after receipt.
# Comma-separated exact tool names are denied, including previously approved calls.
DOMINION_DENIED_TOOLS=
# Result text cap (256..131072 characters). Raw files remain unchanged.
DOMINION_TOOL_RESULT_MAX_CHARS=16384

# Optional non-weight strategy reuse from verified agent runs / adopted RSI.
# false suppresses automatic strategy lookup and reflective extraction, but
# keeps existing historical evidence available to the operator for inspection.
DOMINION_STRATEGY_LEARNING=true

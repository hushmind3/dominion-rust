{
  "name": "@dominion/agent-sdk",
  "version": "0.1.0",
  "description": "First-party SDK for DOMINION's native Rust agent harness",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "node.js",
    "node.d.ts"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0"
}

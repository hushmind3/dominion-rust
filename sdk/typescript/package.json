{
  "name": "@dominion/native-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed client for the DOMINION-owned native Rust agent runtime",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}

{
  "name": "@hushmind3/dominion-sdk",
  "version": "0.1.0",
  "description": "First-party TypeScript client for the Dominion native Rust agent runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "node.mjs",
    "node.d.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.mjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}

{
  "oracleVersion": "rsi-worktree-v2",
  "cases": [
    {
      "id": "memory-explicit",
      "domain": "memory",
      "holdout": true,
      "filter": "engine::room_state::tests::explicit_owner_state_survives_and_a_correction_supersedes_the_old_code"
    },
    {
      "id": "memory-correction",
      "domain": "memory",
      "holdout": true,
      "filter": "engine::room_state::tests::korean_owner_correction_replaces_the_previous_assignment"
    },
    {
      "id": "memory-long",
      "domain": "memory",
      "holdout": true,
      "filter": "engine::room_state::tests::a_hundred_unrelated_owner_decisions_do_not_evict_a_relevant_early_fact"
    },
    {
      "id": "memory-distinct",
      "domain": "memory",
      "holdout": false,
      "filter": "engine::room_state::tests::corrections_keep_unrelated_domains_and_do_not_promote_questions"
    },
    {
      "id": "kernel-generation",
      "domain": "algorithm",
      "holdout": true,
      "filter": "engine::algorithms::tests::generation_uses_evidence_and_returns_executable_kernels"
    },
    {
      "id": "kernel-promotion",
      "domain": "algorithm",
      "holdout": false,
      "filter": "engine::algorithms::tests::unverified_generated_algorithms_never_enter_live_ucb_until_promoted"
    },
    {
      "id": "rsi-oracle",
      "domain": "improver",
      "holdout": true,
      "filter": "engine::rsi::tests::evaluation_cannot_switch_its_frozen_oracle_or_test_names"
    },
    {
      "id": "rsi-lineage",
      "domain": "improver",
      "holdout": true,
      "filter": "engine::rsi::tests::only_a_deployed_improver_can_seed_the_next_generation"
    },
    {
      "id": "memory-quality",
      "domain": "memory",
      "holdout": false,
      "filter": "rsi_frozen_oracle::memory_ranking",
      "metrics": [
        {
          "key": "quality",
          "direction": "higher",
          "minRelativeGain": 0.02,
          "minAbsoluteGain": 0.025
        },
        {
          "key": "elapsedMs",
          "direction": "lower",
          "minRelativeGain": 0.2,
          "minAbsoluteGain": 1,
          "maxRelativeRegression": 0.25
        }
      ]
    },
    {
      "id": "long-recall-quality",
      "domain": "memory",
      "holdout": true,
      "filter": "rsi_frozen_oracle::long_owner_recall",
      "metrics": [
        {
          "key": "quality",
          "direction": "higher",
          "minRelativeGain": 0.02,
          "minAbsoluteGain": 0.025
        },
        {
          "key": "elapsedMs",
          "direction": "lower",
          "minRelativeGain": 0.2,
          "minAbsoluteGain": 1,
          "maxRelativeRegression": 0.25
        },
        {
          "key": "contextChars",
          "direction": "lower",
          "minRelativeGain": 0.1,
          "minAbsoluteGain": 20,
          "maxRelativeRegression": 0.1
        }
      ]
    },
    {
      "id": "planning-quality",
      "domain": "planning",
      "holdout": true,
      "filter": "rsi_frozen_oracle::planning_quality",
      "metrics": [
        {
          "key": "quality",
          "direction": "higher",
          "minRelativeGain": 0.02,
          "minAbsoluteGain": 0.025
        },
        {
          "key": "elapsedMs",
          "direction": "lower",
          "minRelativeGain": 0.2,
          "minAbsoluteGain": 1,
          "maxRelativeRegression": 0.25
        }
      ]
    },
    {
      "id": "search-quality",
      "domain": "improver",
      "holdout": true,
      "filter": "rsi_frozen_oracle::improvement_search",
      "metrics": [
        {
          "key": "quality",
          "direction": "higher",
          "minRelativeGain": 0.02,
          "minAbsoluteGain": 0.025
        },
        {
          "key": "elapsedMs",
          "direction": "lower",
          "minRelativeGain": 0.2,
          "minAbsoluteGain": 1,
          "maxRelativeRegression": 0.25
        }
      ]
    },
    {
      "id": "group-chat-input-cost",
      "domain": "context",
      "holdout": true,
      "filter": "rsi_frozen_oracle::group_chat_context_efficiency",
      "metrics": [
        {
          "key": "quality",
          "direction": "higher",
          "minRelativeGain": 0.02
        },
        {
          "key": "contextChars",
          "direction": "lower",
          "minRelativeGain": 0.05,
          "minAbsoluteGain": 50,
          "maxRelativeRegression": 0.05
        }
      ]
    }
  ]

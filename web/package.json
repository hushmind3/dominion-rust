{
  "name": "dominion",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "description": "DOMINION React/Vite frontend for the native Rust engine",
  "author": "hushmind3",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "cargo run --manifest-path ../Cargo.toml -- --home ..",
    "dev:desktop": "npm run build && cargo run --manifest-path ../Cargo.toml -- --home .. --open",
    "build": "vite build",
    "start": "cargo run --release --manifest-path ../Cargo.toml -- --home .. --open",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --release --manifest-path ../Cargo.toml",
    "check": "npm run typecheck && npm test && npm run build",
    "gate:engine": "cargo test --release --manifest-path ../Cargo.toml --test e2e",
    "desktop:prepare": "node ../scripts/prepare-desktop.mjs",
    "desktop:dev": "node ../scripts/build-desktop.mjs --dev",
    "dist:desktop": "node ../scripts/build-desktop.mjs",
    "dist:mac": "node ../scripts/build-desktop.mjs --bundles app,dmg",
    "dist:windows": "node ../scripts/build-desktop.mjs --bundles nsis,msi"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}

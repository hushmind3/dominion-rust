# Optional: the default URL is the provisioned Dominion-owned Worker.
# Override to use a separate staging Worker without changing production.
VITE_DOMINION_CLOUD_URL=https://dominion-cloud.dominion-hushmind.workers.dev
# Optional: newer Worker versions expose the public Google web OAuth client ID
# via GET /v1/config. If using an older Worker, set the public client ID here.
VITE_DOMINION_GOOGLE_CLIENT_ID=
